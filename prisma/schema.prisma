// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  TECHNICIAN
  EMPLOYEE
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Department {
  HR
  IT
  FINANCE
  SALES
  MARKETING
}

enum TicketStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  CLOSED
  REFUSED
}

model TicketCategory {
  id         Int        @id @default(autoincrement())
  name       String
  department Department

  specializations UserSpecialization[]
  tickets         Ticket[]
}

model User {
  id         Int        @id @default(autoincrement())
  email      String     @unique
  password   String
  firstName  String
  lastName   String
  role       Role
  department Department

  specializations UserSpecialization[]
  permissions     UserPermission[]
  refreshTokens   RefreshToken[]

  ticketsCreated     Ticket[]        @relation("CreatedTickets")
  ticketsAssigned    Ticket[]        @relation("AssignedTickets")
  ticketsLastUpdated Ticket[]        @relation("LastUpdatedTickets")
  ticketMessages     TicketMessage[] @relation("TicketMessages")
  ticketHistory      TicketHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserSpecialization {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId Int
  category   TicketCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId])
}

model UserPermission {
  id      Int     @id @default(autoincrement())
  action  String
  granted Boolean @default(true)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, action])
}

model Ticket {
  id          Int            @id @default(autoincrement())
  title       String
  description String
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)

  categoryId Int?
  category   TicketCategory? @relation(fields: [categoryId], references: [id])

  createdById Int
  createdBy   User @relation("CreatedTickets", fields: [createdById], references: [id])

  assignedToId Int?
  assignedTo   User? @relation("AssignedTickets", fields: [assignedToId], references: [id])

  lastUpdatedById Int?
  lastUpdatedBy   User? @relation("LastUpdatedTickets", fields: [lastUpdatedById], references: [id])

  closingMessage String?

  sourceDepartmentForUser Department
  ticketDepartment        Department

  messages TicketMessage[]

  history TicketHistory[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  dueDate   DateTime?
  closedAt  DateTime?
  deletedAt DateTime?
}

model TicketMessage {
  id      Int    @id @default(autoincrement())
  content String

  // true quando il messaggio è stato generato in chiusura/rifiuto del ticket
  // (in coppia con Ticket.closingMessage, scritti nella stessa transazione)
  isClosingMessage Boolean @default(false)

  ticketId Int
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  authorId Int
  author   User @relation("TicketMessages", fields: [authorId], references: [id])

  createdAt DateTime @default(now())
}

model TicketHistory {
  id Int @id @default(autoincrement())

  ticketId Int
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  actorId Int?
  actor   User? @relation(fields: [actorId], references: [id])

  snapshotBefore Json

  // Campi effettivamente modificati in questo evento, es. ["status", "priority", "dueDate"].
  // Evita di dover fare il diff tra snapshotBefore e lo stato attuale (che nel frattempo
  // può essere ulteriormente cambiato) per capire cosa è variato.
  changedFields String[]

  createdAt DateTime @default(now())
}