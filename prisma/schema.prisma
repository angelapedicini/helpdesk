// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  TECHNICIAN
  EMPLOYEE
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Department {
  HR
  IT
  FINANCE
  SUPPORT
  LOGISTIC
}

enum TicketStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  CLOSED
  REFUSED
}

enum TicketSpecificField {
  HARDWARE_TYPE // IT.itSpecific.hardwareType
  SOFTWARE // IT.itSpecific.software
  PAYROLL_REFERENCE // HR.hrSpecific.payrollReference
  EMPLOYEE_REFERENCE // HR.hrSpecific.employeeReference
  CUSTOMER // FINANCE/SUPPORT/LOGISTIC .customer
  INVOICE_REFERENCE // FINANCE.financeSpecific.invoiceReference
  BUDGET_TYPE // FINANCE.financeSpecific.budgetType
  SHIPMENT_REFERENCE // LOGISTIC.logisticSpecific.shipmentReference
}

model TicketCategory {
  id            Int                  @id @default(autoincrement())
  name          String
  department    Department
  specificField TicketSpecificField? // null = nessuna specifica richiesta per questa categoria

  accessGrants    TicketCategoryAccess[]
  specializations UserSpecialization[]
  tickets         Ticket[]
  ticketHistories TicketHistory[]
}

model TicketCategoryAccess {
  id Int @id @default(autoincrement())

  categoryId Int
  category   TicketCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  requesterDepartment Department? // null = tutti i dipartimenti
  requesterMinRole    Role        @default(EMPLOYEE) // ruolo minimo richiesto (gerarchia EMPLOYEE < TECHNICIAN < ADMIN)

  @@unique([categoryId, requesterDepartment, requesterMinRole])
}

model User {
  id         Int        @id @default(autoincrement())
  email      String     @unique
  password   String
  firstName  String
  lastName   String
  role       Role
  department Department

  specializations UserSpecialization[]
  permissions     UserPermission[]
  refreshTokens   RefreshToken[]

  ticketsCreated     Ticket[]        @relation("CreatedTickets")
  ticketsAssigned    Ticket[]        @relation("AssignedTickets")
  ticketsLastUpdated Ticket[]        @relation("LastUpdatedTickets")
  ticketMessages     TicketMessage[] @relation("TicketMessages")

  ticketReadStates               TicketReadState[]
  adminNotificationSubscriptions TicketAdminNotificationSubscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // nuova history (TicketHistory2)
  ticketHistoriesCreated     TicketHistory[] @relation("CreatedTicketsHistory")
  ticketHistoriesAssigned    TicketHistory[] @relation("AssignedTicketsHistory")
  ticketHistoriesLastUpdated TicketHistory[] @relation("LastUpdatedTicketsHistory")
  ticketHistoryDeletions     TicketHistory[] @relation("TicketHistoryDeletedBy")
}

model UserSpecialization {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId Int
  category   TicketCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId])
}

model UserPermission {
  id      Int     @id @default(autoincrement())
  action  String
  granted Boolean @default(true)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, action])
}

model Ticket {
  id          Int            @id @default(autoincrement())
  title       String
  description String
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)

  categoryId Int?
  category   TicketCategory? @relation(fields: [categoryId], references: [id])

  createdById Int
  createdBy   User @relation("CreatedTickets", fields: [createdById], references: [id])

  assignedToId Int?
  assignedTo   User? @relation("AssignedTickets", fields: [assignedToId], references: [id])

  lastUpdatedById Int?
  lastUpdatedBy   User? @relation("LastUpdatedTickets", fields: [lastUpdatedById], references: [id])

  closingMessage String?

  sourceDepartmentForUser Department
  ticketDepartment        Department

  // Ticket specifics
  itSpecific       TicketITSpecific?
  hrSpecific       TicketHRSpecific?
  financeSpecific  TicketFinanceSpecific?
  supportSpecific  TicketSupportSpecific?
  logisticSpecific TicketLogisticSpecific?

  messages TicketMessage[]

  readStates                     TicketReadState[]
  adminNotificationSubscriptions TicketAdminNotificationSubscription[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  dueDate   DateTime?
  closedAt  DateTime?
}

/// Nuova history: mirror 1:1 dei campi del Ticket al momento della cancellazione.
/// Sostituisce la vecchia TicketHistory basata su snapshot Json.
model TicketHistory {
  id Int @id @default(autoincrement())

  // riferimento "storico" al ticket originale: NON è una FK vincolante,
  // il ticket puo' non esistere piu' (hard delete)
  originalTicketId Int

  title       String
  description String
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)

  categoryId Int?
  category   TicketCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  createdById Int?
  createdBy   User? @relation("CreatedTicketsHistory", fields: [createdById], references: [id], onDelete: SetNull)

  assignedToId Int?
  assignedTo   User? @relation("AssignedTicketsHistory", fields: [assignedToId], references: [id], onDelete: SetNull)

  lastUpdatedById Int?
  lastUpdatedBy   User? @relation("LastUpdatedTicketsHistory", fields: [lastUpdatedById], references: [id], onDelete: SetNull)

  closingMessage String?

  sourceDepartmentForUser Department
  ticketDepartment        Department

  ticketSpecific String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  dueDate   DateTime?
  closedAt  DateTime?

  deletedAt   DateTime?
  deletedById Int?
  deletedBy   User?    @relation("TicketHistoryDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  @@index([originalTicketId])
  @@index([status, deletedAt])
  @@index([ticketDepartment, deletedAt])
  @@index([deletedById])
}

model TicketMessage {
  id      Int    @id @default(autoincrement())
  content String

  ticketId Int
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  authorId Int
  author   User @relation("TicketMessages", fields: [authorId], references: [id])

  createdAt DateTime @default(now())

  readStates TicketReadState[]

  @@index([ticketId, id])
}

model TicketReadState {
  userId            Int
  ticketId          Int
  lastReadMessageId Int?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  lastReadMessage TicketMessage? @relation(fields: [lastReadMessageId], references: [id])

  @@id([userId, ticketId])
}

model TicketAdminNotificationSubscription {
  userId   Int
  ticketId Int

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, ticketId])
}

model TicketITSpecific {
  id       Int @id @default(autoincrement())
  ticketId Int @unique

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  hardwareType HardwareType?
  software     Software?
}

model TicketHRSpecific {
  id       Int @id @default(autoincrement())
  ticketId Int @unique

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  payrollReference  String?
  employeeReference String?
}

model TicketFinanceSpecific {
  id       Int @id @default(autoincrement())
  ticketId Int @unique

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  customer         Customer?
  invoiceReference String?
  budgetType       BudgetType?
}

model TicketSupportSpecific {
  id       Int @id @default(autoincrement())
  ticketId Int @unique

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  customer Customer?
}

model TicketLogisticSpecific {
  id       Int @id @default(autoincrement())
  ticketId Int @unique

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  customer          Customer?
  shipmentReference String?
}

enum HardwareType {
  LAPTOP
  DESKTOP
  MONITOR
  KEYBOARD
  MOUSE
  DOCKING_STATION
  PRINTER
  SMARTPHONE
  TABLET
  SERVER
}

enum Software {
  JIRA
  SLACK
  MICROSOFT_TEAMS
  OUTLOOK
  EXCEL
  WORD
  POWERPOINT
  SAP
  SALESFORCE
  GITHUB
  GITLAB
  CONFLUENCE
}

enum Customer {
  ACME
  MICROSOFT
  GOOGLE
  AMAZON
  APPLE
  IBM
  ORACLE
  SAP
  DELOITTE
  ACCENTURE
}

enum BudgetType {
  NEW_HARDWARE
  SOFTWARE_LICENSE
  CLOUD_SERVICES
  IT_INFRASTRUCTURE
  OFFICE_EQUIPMENT
  CONSULTING
  TRAINING
  MAINTENANCE
  SECURITY
  TRAVEL
}


model DemoSession {
  id               String   @id @default(uuid())
  neonBranchId     String
  connectionString String
  createdAt        DateTime @default(now())
  expiresAt        DateTime

  @@index([expiresAt])
}
