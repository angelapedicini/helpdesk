enum Role {
  ADMIN
  TECHNICIAN
  EMPLOYEE
}

enum Department {
  HR
  IT
  FINANCE
  SALES
  MARKETING
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

model TicketCategory {
  id         Int        @id @default(autoincrement())
  name       String
  department Department

  specializations UserSpecialization[]
  tickets         Ticket[]
}

model User {
  id        Int        @id @default(autoincrement())
  email     String     @unique
  password  String
  firstName String
  lastName  String
  role      Role
  department Department

  specializations UserSpecialization[]
  permissions     UserPermission[]
  refreshTokens   RefreshToken[]

  ticketsCreated  Ticket[] @relation("CreatedTickets")
  ticketsAssigned Ticket[] @relation("AssignedTickets")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserSpecialization {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId Int
  category   TicketCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId])
}

model UserPermission {
  id      Int     @id @default(autoincrement())
  action  String
  granted Boolean @default(true)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, action])
}

model Ticket {
  id          Int          @id @default(autoincrement())
  title       String
  description String
  status      TicketStatus @default(OPEN)

  categoryId Int
  category   TicketCategory @relation(fields: [categoryId], references: [id])

  createdById Int
  createdBy   User @relation("CreatedTickets", fields: [createdById], references: [id])

  assignedToId Int?
  assignedTo   User? @relation("AssignedTickets", fields: [assignedToId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
}